{
  "name": "@hanzo/dev-core",
  "version": "0.1.6",
  "description": "The Hanzo Dev core (threads, composer, model picker) as a library for a host's own shell.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "index.d.ts", "keymap.d.ts"],
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./dist/index.js" },
    "./keymap": { "types": "./keymap.d.ts", "import": "./dist/keymap.js" },
    "./style.css": "./dist/index.css"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/hanzoai/dev.git", "directory": "packages/dev" }
}
