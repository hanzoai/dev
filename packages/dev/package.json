{
  "name": "@hanzo/dev",
  "version": "4.2.0",
  "description": "The unified Hanzo Dev & Builder library (Dev core threads/composer/runtime + Builder workspace, sessions, routes, plans, and host providers).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/dev.git",
    "directory": "packages/dev"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build:builder": "rm -rf dist/builder && tsc -p tsconfig.builder.json",
    "build:assemble": "node scripts/assemble.mjs",
    "build": "pnpm --filter @hanzodev/web build:embed && pnpm run build:builder && pnpm run build:assemble",
    "typecheck": "tsc -p tsconfig.builder.json --noEmit",
    "test": "vp test run --config vitest.config.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js",
      "default": "./dist/builder/index.js"
    },
    "./keymap": {
      "types": "./dist/keymap.d.ts",
      "import": "./dist/keymap.js",
      "default": "./dist/keymap.js"
    },
    "./style.css": "./dist/index.css",
    "./plan": {
      "types": "./dist/builder/plan.d.ts",
      "import": "./dist/builder/plan.js",
      "default": "./dist/builder/plan.js"
    },
    "./route": {
      "types": "./dist/builder/route.d.ts",
      "import": "./dist/builder/route.js",
      "default": "./dist/builder/route.js"
    },
    "./mind": {
      "types": "./dist/builder/mind.d.ts",
      "import": "./dist/builder/mind.js",
      "default": "./dist/builder/mind.js"
    },
    "./handoff": {
      "types": "./dist/builder/handoff.d.ts",
      "import": "./dist/builder/handoff.js",
      "default": "./dist/builder/handoff.js"
    },
    "./dev-mode": {
      "types": "./dist/builder/dev-mode.d.ts",
      "import": "./dist/builder/dev-mode.js",
      "default": "./dist/builder/dev-mode.js"
    },
    "./names": {
      "types": "./dist/builder/names.d.ts",
      "import": "./dist/builder/names.js",
      "default": "./dist/builder/names.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.160.2",
    "@tanstack/react-store": "^0.8.1",
    "use-sync-external-store": "^1.6.0"
  },
  "peerDependencies": {
    "@hanzo/composer": ">=0.2.0",
    "@hanzo/gui": ">=8.3.5",
    "@hanzo/i18n": ">=0.5.5",
    "@hanzo/ui": ">=8.30.3",
    "@hanzo/voice": ">=0.1.19",
    "@hanzogui/lucide-icons-2": ">=8.3.5",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@hanzo/composer": {
      "optional": true
    },
    "@hanzo/gui": {
      "optional": true
    },
    "@hanzo/i18n": {
      "optional": true
    },
    "@hanzo/ui": {
      "optional": true
    },
    "@hanzo/voice": {
      "optional": true
    },
    "@hanzogui/lucide-icons-2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hanzo/composer": "0.2.0",
    "@hanzo/gui": "8.3.5",
    "@hanzo/i18n": "0.5.5",
    "@hanzo/ui": "8.30.3",
    "@hanzo/voice": "0.1.19",
    "@hanzogui/lucide-icons-2": "8.3.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.87.0",
    "react-native-svg": "15.16.1",
    "typescript": "7.0.2"
  }
}
