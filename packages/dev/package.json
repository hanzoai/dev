{
  "name": "@hanzo/dev-core",
  "version": "0.1.17",
  "description": "The Hanzo Dev core (threads, composer, model picker) as a library for a host's own shell.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/dev.git",
    "directory": "packages/dev"
  },
  "files": [
    "dist",
    "index.d.ts",
    "keymap.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    },
    "./keymap": {
      "types": "./keymap.d.ts",
      "import": "./dist/keymap.js"
    },
    "./style.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.160.2",
    "@tanstack/react-store": "^0.8.1",
    "use-sync-external-store": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
