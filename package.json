{
  "name": "dev-monorepo",
  "private": true,
  "description": "Tools for repo-wide maintenance.",
  "scripts": {
    "format": "prettier --check *.json *.md .github/workflows/*.yml **/*.js",
    "format:fix": "prettier --write *.json *.md .github/workflows/*.yml **/*.js",
    "build": "make release",
    "build:dev": "make build",
    "build:quick": "make release",
    "test:local": "make build && ./target/debug/dev --version",
    "fix": "cargo fmt && cargo fix --allow-dirty && cargo clippy --fix --allow-dirty"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "resolutions": {
    "@babel/core": "7.29.6",
    "@modelcontextprotocol/sdk": "1.26.0",
    "braces": "^3.0.3",
    "brace-expansion@1.1.12": "1.1.18",
    "brace-expansion@5.0.5": "5.0.9",
    "esbuild": "0.28.1",
    "flatted": "3.4.2",
    "glob@10.4.5": "10.5.0",
    "handlebars": "4.7.9",
    "js-yaml": "4.3.1",
    "micromatch": "^4.0.8",
    "minimatch@3.1.2": "3.1.4",
    "minimatch@9.0.5": "9.0.7",
    "path-to-regexp": "8.4.0",
    "picomatch@2.3.1": "2.3.2",
    "picomatch@4.0.3": "4.0.4",
    "rollup": "4.59.0",
    "semver": "^7.7.1"
  },
  "overrides": {
    "punycode": "^2.3.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@11.24.0"
}
