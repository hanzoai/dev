# Optional: Hanzo IAM & Hanzo Connect source builds
# `cp .env.example .env` configures Hanzo IAM OIDC and Hanzo Connect Relay.
# Native Hanzo IAM defaults to https://hanzo.id (`hanzo-app`) and supports
# multi-account switching across hanzo.id, lux.id, zoolabs.id, and pars.id.
# Do not add server-side secrets to this file.

# Primary Hanzo IAM OIDC issuer & client ID (Casdoor / OIDC + PKCE)
HANZO_DEV_IAM_ISSUER=https://hanzo.id
HANZO_DEV_IAM_CLIENT_ID=hanzo-app

# Production relay for unified cross-machine & mobile remote control.
HANZO_DEV_RELAY_URL=https://relay.dev.hanzo.ai

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://hanzo.bot; override to test against a staging deployment.
# HANZO_DEV_HOSTED_APP_URL=https://nightly.hanzo.bot

# Public, ingest-only mobile OpenTelemetry configuration.
# HANZO_DEV_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# HANZO_DEV_MOBILE_OTLP_TRACES_DATASET=hanzo-dev-mobile-traces-dev
# HANZO_DEV_MOBILE_OTLP_TRACES_TOKEN=xaat-...
