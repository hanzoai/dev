{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanzo Dev",
  "version": "0.1.10",
  "identifier": "ai.hanzo.dev",
  "build": {
    "beforeBuildCommand": "node scripts/stage-tauri-resources.mjs",
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5733"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hanzo", "hanzodev", "hanzo-dev"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
