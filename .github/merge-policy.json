{
  "_comment": "code-rs/** is the workspace that SHIPS. The vendor/codex/** entries below guard the vendored upstream copy; the code-rs/** entries guard the product. Files carrying Hanzo identity (default provider, default model, binary name, login command) are listed explicitly so an upstream merge cannot take them back. code-rs/core/tests/hanzo_identity.rs asserts the same invariants and fails the build if it does.",
  "prefer_ours_globs": [
    "code-rs/core/src/model_provider_info.rs",
    "code-rs/core/src/config.rs",
    "code-rs/core/src/auth.rs",
    "code-rs/core/tests/hanzo_identity.rs",
    "code-rs/cli/Cargo.toml",
    "code-rs/cli/src/main.rs",
    "code-rs/exec/src/event_processor_with_human_output.rs",
    "code-rs/mcp-server/src/message_processor.rs",
    "code-rs/tui/**",
    "vendor/codex/tui/**",
    "codex-cli/**",
    "vendor/codex/core/src/openai_tools.rs",
    "vendor/codex/core/src/codex.rs",
    "vendor/codex/core/src/agent_tool.rs",
    "vendor/codex/core/src/default_client.rs",
    "vendor/codex/protocol/src/models.rs",
    ".github/workflows/**",
    "docs/**",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "prefer_theirs_globs": [
    "vendor/codex/common/**",
    "vendor/codex/exec/**",
    "vendor/codex/file-search/**"
  ],
  "purge_globs": [
    ".github/codex-cli-*.png",
    ".github/codex-cli-*.jpg",
    ".github/codex-cli-*.jpeg",
    ".github/codex-cli-*.webp"
  ],
  "perma_removed_paths": [
    ".github/workflows/rust-ci.yml",
    ".github/workflows/rust-ci-full.yml"
  ]
}
