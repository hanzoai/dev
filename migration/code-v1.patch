new file mode 100644
index 0000000..ad7cfa5
--- /dev/null
+++ b/tui/src/bottom_pane/composer_status.rs
@@ -0,0 +1,31 @@
+use std::time::Duration;
+
+use ratatui::style::{Color, Modifier, Style};
+use ratatui::text::{Line, Span};
+
+/// The animated status stays left aligned above the editable surface.
+pub(super) fn working_line(elapsed: Duration) -> Line<'static> {
+    let seconds = elapsed.as_secs();
+    let clock = if seconds < 60 {
+        format!("{seconds}s")
+    } else if seconds < 3600 {
+        format!("{}m {:02}s", seconds / 60, seconds % 60)
+    } else {
+        format!("{}h {:02}m", seconds / 3600, seconds / 60 % 60)
+    };
+    let base = crate::colors::color_to_rgb(crate::colors::text_dim());
+    let bright = crate::colors::color_to_rgb(crate::colors::text());
+    let phase = (elapsed.as_millis() / 90 % 18) as i32 - 3;
+    let mut spans = vec![Span::styled("• ", Style::default().fg(crate::colors::text_dim()))];
+    for (index, ch) in "Working".chars().enumerate() {
+        let strength = (1.0 - (index as i32 - phase).abs() as f32 / 3.0).max(0.0);
+        let mix = |a: u8, b: u8| (a as f32 + (b as f32 - a as f32) * strength) as u8;
+        let color = Color::Rgb(mix(base.0, bright.0), mix(base.1, bright.1), mix(base.2, bright.2));
+        spans.push(Span::styled(ch.to_string(), Style::default().fg(color).add_modifier(Modifier::BOLD)));
+    }
+    spans.push(Span::styled(
+        format!(" ({clock} · esc to interrupt)"),
+        Style::default().fg(crate::colors::text_dim()),
+    ));
+    Line::from(spans)
+}
