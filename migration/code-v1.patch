-    let mut out = vec![vec![false; w]; h];
-    for y in 0..h {
-        for x in 0..w {
-            if !mask[y][x] {
-                continue;
-            }
-            let up = y == 0 || !mask[y - 1][x];
-            let down = y + 1 >= h || !mask[y + 1][x];
-            let left = x == 0 || !mask[y][x - 1];
-            let right = x + 1 >= w || !mask[y][x + 1];
-            if up || down || left || right {
-                out[y][x] = true;
-            }
-        }
-    }
-    out
-}
