+use super::*;
+
+#[test]
+fn working_line_and_input_surface_are_distinct() {
+    let (tx, _rx) = std::sync::mpsc::channel();
+    let mut composer = ChatComposer::new(true, AppEventSender::new(tx), true, false);
+    composer.is_task_running = true;
+    composer.status_message = "Working".into();
+    let area = Rect::new(0, 0, 80, 4);
+    let mut buffer = Buffer::empty(area);
+    composer.render_ref(area, &mut buffer);
+    let row: String = (0..80).map(|x| buffer[(x, 0)].symbol()).collect();
+    assert!(row.starts_with("• Working (0s · esc to interrupt)"), "{row}");
+    assert_ne!(buffer[(10, 1)].bg, crate::colors::background());
+    assert_eq!(buffer[(10, 0)].bg, crate::colors::background());
+}
