-fn shift_left(lines: Vec<String>, n: usize) -> Vec<String> {
-    let mut out = Vec::with_capacity(lines.len());
-    for line in lines {
-        let mut drop = n;
-        let mut new_line = String::with_capacity(line.len());
-        for ch in line.chars() {
-            if drop > 0 && ch == ' ' {
-                drop -= 1;
-                continue;
-            }
-            new_line.push(ch);
-        }
-        out.push(new_line);
-    }
-    out
-}
